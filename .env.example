# MUSAFIRCAFE PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env.local for local testing or configure in your production hosting platform (Vercel / Cloud).
# NEVER commit real production secrets or private keys to source control!

# Session & Security Secret (Required)
# Generate with: openssl rand -base64 32
SESSION_SECRET=musafir_cafe_nepal_secret_signing_key_2026_sah_family

# Master Admin Password override (Optional)
ADMIN_PASSWORD=MusafirSah2026!

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://musafircafe.com

# -------------------------------------------------------------
# Firebase Integration (Optional - if connecting Cloud Firestore & Auth)
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=musafircafe-production.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=musafircafe-production
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=musafircafe-production.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-Side Firebase Admin (Never expose to client!)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
